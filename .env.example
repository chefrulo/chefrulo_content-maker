# Claude CLI — auto-detected by `npm run setup`, override only if detection fails
CLAUDE_CLI_PATH=

# Instagram Graph API (Phase 2 — Instagram MCP, and Phase 6 — publish)
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# Apify (Phase 3 — inspiration account scraping)
APIFY_API_TOKEN=

# OpenAI TTS (Phase 5 — voiceover, same voice as The Journal for brand consistency)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# VPS video hosting (Phase 6 — publish, see publish-reel.mjs)
VPS_HOST=
VPS_USER=
VPS_PRIVATE_KEY_PATH=
VPS_REMOTE_DIR=
VPS_PUBLIC_BASE_URL=
