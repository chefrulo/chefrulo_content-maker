# Claude CLI — auto-detected by `npm run setup`, override only if detection fails
CLAUDE_CLI_PATH=

# Instagram Graph API (Phase 2 — Instagram MCP, and Phase 6 — publish)
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# Apify (Phase 3 — inspiration account scraping)
APIFY_API_TOKEN=

# Chef Rulo Brand Brain (Phase 4 — brief generation editorial guardrails)
# Path to the chef-rulo-brand-brain repo. When set, its knowledge/00-foundation/
# docs (positioning, editorial manifesto, writing style, guardrails) are injected
# into every brief-generation prompt. Optional — briefs still generate without it.
BRAND_BRAIN_PATH=

# OpenAI TTS (Phase 5 — voiceover, same voice as The Journal for brand consistency)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin

# Phase 6 — publish: no config needed. Uses a local cloudflared quick tunnel
# to expose the rendered MP4 to Meta's servers just long enough to publish,
# instead of a VPS. Requires the `cloudflared` binary on PATH.
